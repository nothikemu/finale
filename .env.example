# Copy to .env.local for development, or set these in your host's secret manager.
# Values here are placeholders only. Never commit real credentials.

# --- Discord presence (public identifier, not a credential) -------------------
# Your numeric Discord user ID. The account must also be tracked by Lanyard
# (join https://discord.gg/UrXF2cfJ7F). See README for exact steps.
DISCORD_USER_ID=

# --- ListenBrainz ----------------------------------------------------------------
# Simplest and safest: just your ListenBrainz username. Public listens need no
# token, so there is nothing secret to leak.
LISTENBRAINZ_USERNAME=
# Alternative: a user token from https://listenbrainz.org/settings/ . Used only on
# the server, once, to look up your username. Keep it out of the repo, the
# browser and logs. Not needed if LISTENBRAINZ_USERNAME is set.
LISTENBRAINZ_TOKEN=

# --- GitHub (server-side only) ------------------------------------------------
# Fine-grained personal access token limited to "Public repositories (read-only)"
# with no additional permissions. Required for the GraphQL contribution calendar.
GITHUB_TOKEN=

# --- Troubleshooting ------------------------------------------------------------
# Set to 1 to show owner-only setup/failure hints inside the panels of a
# production build (they always show in `npm run dev`). Run `npm run doctor`
# for a full connectivity report.
SHOW_DIAGNOSTICS=

# --- Discord profile fallbacks (owner-supplied, not live Discord fields) ------
# Lanyard does not relay a Discord banner or "About Me". The site reads them from
# your Lanyard KV keys "bio" and "banner" (see README). These two are only the
# last-resort fallbacks if KV is empty. PROFILE_BANNER_URL must be https://.
PROFILE_BANNER_URL=
PROFILE_BIO=
