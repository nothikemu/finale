{
  "name": "nothikemu-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Compact personal dashboard: live Discord presence, socials, recent listening, about, GitHub activity and projects.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "fonts": "python3 -I scripts/build-fonts.py",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
